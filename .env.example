# Marx Simplified Environment Configuration Example
# Copy this file to .env or .env.local and populate with your credentials.

# Discord Webhook URL for Word of the Day notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Base web application URL used for linking terms in Discord embeds
SITE_URL=https://marxsimplified.onrender.com

# Allowed theory categories (comma-separated list).
# Only terms matching at least one of these categories will be selected.
# Leave empty ("") or set to "all" to select from all categories.
# Default: Marxism-Leninism, Maoism, Marxist Feminism
ALLOWED_CATEGORIES=Marxism-Leninism, Maoism, Marxist Feminism

# Excluded theory categories when accepting all categories (comma-separated list).
# Used when ALLOWED_CATEGORIES is empty.
# Default: Capitalist Theory, Bourgeois Philosophy
EXCLUDED_CATEGORIES=Capitalist Theory, Bourgeois Philosophy
