{
  "name": "marxsimplified",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/sync-manifest.js && tsc -b && vite build && node tools/prerender-meta.js",
    "sync": "node tools/sync-manifest.js",
    "sync:og": "node tools/generate-og-images.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node scripts/verify-annotations.js && node tools/check-glossary.js",
    "test:glossary": "node tools/check-glossary.js",
    "discord:wotd": "node discord/send-word-of-the-day.js",
    "discord:wotd:dry": "node discord/send-word-of-the-day.js --dry-run",
    "discord:cron": "node discord/cron-runner.js",
    "discord:cron:daemon": "node discord/cron-runner.js --daemon"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
